<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>sar_robot_control</name>
  <version>0.1.0</version>
  <description>Control nodes for the IRIS drone (via MAVROS) and the TurtleBot3 rover, exposing simple service interfaces for CrewAI agents</description>
  <maintainer email="anonymous@example.invalid">Anonymous</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sar_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
