<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <!-- ROS <-> Gazebo bridge plugin for /gazebo/get_entity_state (used to
         read the victim's pose). libgazebo_ros_init.so and
         libgazebo_ros_factory.so (needed for spawn_entity) are already
         added by PX4's sitl_run.sh via "-s" flags when ROS_VERSION=2, so
         they are intentionally NOT duplicated here. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>-8 -8 6 0 0.4 0.78</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>250</real_time_update_rate>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- "Rubble" / building obstacles scattered around the search area -->
    <model name="rubble_1">
      <static>true</static>
      <pose>4 3 0.5 0 0 0.4</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2 1.5 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2 1.5 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="rubble_2">
      <static>true</static>
      <pose>-3 5 0.75 0 0 -0.3</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.5 1.5 1.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>1.5 1.5 1.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="rubble_3">
      <static>true</static>
      <pose>2 -4 0.4 0 0 0.9</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3 1 0.8</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>3 1 0.8</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- The person to be located by the drone and reached by the rover -->
    <include>
      <name>victim</name>
      <pose>5 5 0 0 0 0</pose>
      <uri>model://victim</uri>
    </include>

  </world>
</sdf>
